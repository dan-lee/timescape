{
  "private": true,
  "name": "demo",
  "version": "1.3.5",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "concurrently -n 'integration,storybook' 'pnpm vite --port 4949' 'pnpm storybook:dev --no-open'",
    "dev:integrations": "vite build && concurrently 'pnpm storybook:build' 'vite build -l error -w'",
    "build": "pnpm typecheck && vite build && pnpm storybook:build",
    "preview": "vite preview",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-dist",
    "storybook:test": "storybook test",
    "test": "playwright test"
  },
  "dependencies": {
    "@rehookify/datepicker": "6.6.8",
    "htm": "3.1.1",
    "preact": "10.29.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "timescape": "workspace:*",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@iconify-icon/react": "3.0.3",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/browser": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-vue": "6.0.9",
    "concurrently": "10.0.5",
    "storybook": "10.6.0",
    "storybook-addon-code-editor": "^6.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.0"
  }
}
